# Supabase project URL (Project Settings -> API)
SUPABASE_URL=

# Use a Supabase Secret key or legacy service_role key for this API server.
# Never commit a real key or expose it in a browser.
SUPABASE_KEY=replace-with-new-server-secret-key

# Public anon/publishable key used only for Supabase Auth signup and login.
SUPABASE_ANON_KEY=replace-with-project-anon-key
# Local language reader: python -m scripts.prepare_jana_reader,
# then powershell -File scripts/start_jana_reader.ps1.
# Inference stays on this machine. No API key or cloud fallback.
JANA_READER_URL=http://127.0.0.1:8081
JANA_READER_MODEL=jana-reader
JANA_READER_TIMEOUT_SECONDS=180

# Historical FAQ evaluation only; no longer used by /ai/ask.
JANA_MODEL_DIR=.models/mpnet
JANA_FAQ_PATH=knowledge_base/faq.json
JANA_MIN_SCORE=0.72
JANA_SCORE_MARGIN=0.045

# Legacy paid evaluation script ONLY (scripts.evaluate_jana).
# The HTTP agent does not read/use these settings for inference.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Per model call; up to two calls per question, no automatic retry.
JANA_MODEL_TIMEOUT_SECONDS=20

# Future signed event gateways; disabled until an actual receiver is configured.
# HTTPS endpoints must acknowledge {"event_id":"...", "accepted":true} and deduplicate IDs.
INTEGRATION_1C_ENABLED=false
INTEGRATION_1C_URL=
INTEGRATION_1C_SECRET=
INTEGRATION_DOCUMENTOLOG_ENABLED=false
INTEGRATION_DOCUMENTOLOG_URL=
INTEGRATION_DOCUMENTOLOG_SECRET=
