# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://zcsoipcwymhowmvnytxf.supabase.co

# Use a Supabase Secret key or legacy service_role key for this API server.
# Never commit a real key or expose it in a browser.
SUPABASE_KEY=replace-with-new-server-secret-key

# Public anon/publishable key used only for Supabase Auth signup and login.
SUPABASE_ANON_KEY=replace-with-project-anon-key
# Local FAQ agent: prepare once with python -m scripts.prepare_jana_local.
# Inference needs no network, paid key, Docker or GPU.
JANA_MODEL_DIR=.models/mpnet
JANA_FAQ_PATH=knowledge_base/faq.json
JANA_MIN_SCORE=0.72
JANA_SCORE_MARGIN=0.045

# Legacy paid evaluation script ONLY (scripts.evaluate_jana).
# The HTTP agent does not read/use these settings for inference.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Per model call; up to two calls per question, no automatic retry.
JANA_MODEL_TIMEOUT_SECONDS=20
