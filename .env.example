# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://zcsoipcwymhowmvnytxf.supabase.co

# Use a Supabase Secret key or legacy service_role key for this API server.
# Never commit a real key or expose it in a browser.
SUPABASE_KEY=replace-with-new-server-secret-key

# Public anon/publishable key used only for Supabase Auth signup and login.
SUPABASE_ANON_KEY=replace-with-project-anon-key
# Optional. Without this, Jana returns matched, cited knowledge-base excerpts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
JANA_KAZAKH_MODEL=gpt-4.1
JANA_PROVIDER=openai
# Optional compose.ai.yaml: absolute path to an existing local GGUF model.
# JANA_MODEL_PATH=E:/Models/Qwen3-8B-Q4_K_M.gguf
# POSTTECH_HTTP_PORT=8000

# Optional isolated local Jana endpoint: /api/v1/ai/local/ask.
# Install requirements-local-ai.txt and prepare models before enabling a reader.
JANA_READER_URL=http://127.0.0.1:8081
JANA_READER_ALLOW_DOCKER_HOST=false
JANA_READER_MODEL=jana-reader
JANA_READER_TIMEOUT_SECONDS=120
# JANA_MODEL_DIR=.models/mpnet
# JANA_FAQ_PATH=knowledge_base/faq.json

# HR invitation emails (independent from Supabase confirmation/reset SMTP).
RESEND_API_KEY=
INVITATION_EMAIL_FROM="PostTech <onboarding@resend.dev>"
# Optional reachable portal address; omit when demonstrating only on localhost.
PORTAL_PUBLIC_URL=

# Future signed event gateways; disabled until an actual receiver is configured.
# HTTPS endpoints must acknowledge {"event_id":"...", "accepted":true} and deduplicate IDs.
INTEGRATION_1C_ENABLED=false
INTEGRATION_1C_URL=
INTEGRATION_1C_SECRET=
INTEGRATION_DOCUMENTOLOG_ENABLED=false
INTEGRATION_DOCUMENTOLOG_URL=
INTEGRATION_DOCUMENTOLOG_SECRET=

# Optional Telegram: private .local/telegram.env, never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WORKER_SECRET=
