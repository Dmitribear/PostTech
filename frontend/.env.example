# Development proxy. Browser requests stay on the same origin.
API_PROXY_TARGET=http://127.0.0.1:8000
# Optional public API URL for a separately hosted frontend (requires API CORS).
# VITE_API_BASE_URL=/api/v1
# Optional development-only bridge: fictional HR data + actual local Jana model.
# Run examples.jana_local_demo on 127.0.0.1:8002, then enable this in .env.local.
# VITE_DEMO_JANA_PROXY=/jana-demo
# Never put Supabase service keys, passwords, or OpenAI keys in frontend env files.
